# ROM de teste: motor gta2_re (decomp do GTA 2 PC) compilado para N64 + camada de plataforma (port/n64).
# Etapa 1: renderer nulo; objetivo e ver o motor inicializar e quanta RAM ele pede.
#   powershell -File build_recomp.ps1        (ou: make -f Makefile.recomp)
# Os dados do jogo (freeware) sao copiados de ../gta2_data/data para o DragonFS (uso pessoal).
BUILD_DIR = build_recomp
OBJ_DIR   = $(BUILD_DIR)/o
N64_ROM_SAVETYPE = sram256k
N64_INST ?= /opt/libdragon
include $(N64_INST)/include/n64.mk
N64_CXXFLAGS ?= $(N64_CFLAGS)

GAME_DATA ?= ../gta2_data/data
FS_DIR     = filesystem_recomp
# --- dados do jogo na ROM (DragonFS) ---
# Menu original do GTA 2: 25 telas TGA (~9,6 MB). INCLUDE_FRONTEND=0 tira as telas (a ROM encolhe, mas o menu nao abre: use
# Z ao ligar para entrar direto no mapa).
INCLUDE_FRONTEND ?= 1
FRONTEND_DIR = $(if $(filter 1,$(INCLUDE_FRONTEND)),frontend,)
# Mapas (cidades): bil = City 3 (Industrial), ste = City 2 (Residential), wil = City 1 (Downtown). Cada um: .gmp + .sty + .scr + pasta de missoes.
# Para uma ROM menor, ex.: MAPS="bil".
MAPS ?= bil ste wil
MAP_ENTRIES = $(foreach m,$(MAPS),$(m).gmp $(m).sty $(m).scr $(m))
# Fases bonus de cada cidade (listadas em test1.seq: lorne2 = wil, mike1 = ste, mike2 = bil): .gmp + .scr
BONUS ?= lorne2e lorne2m lorne2h mike1e mike1m mike1h mike2e mike2m mike2h
BONUS_ENTRIES = $(foreach b,$(BONUS),$(b).gmp $(b).scr)
# Radios (musica): todas as estacoes numeradas. A.wav e D.wav (CD-check do jogo) ficam de fora ate se saber onde sao usadas.
RADIOS ?= 1 2 3 4 5 5a 6 6a 7 7a 8 8a 9 9a 10 10a 11 11a 12 101a
RADIO_ENTRIES = $(foreach r,$(RADIOS),gtaudio/$(r).wav)
# Arquivos/pastas de dados para o boot (sem diferenciar maiusculas). Ajuste a lista conforme o motor for pedindo (veja o log "fopen(...)").
# Bancos de efeitos: tools/stage_data.sh junta bil/ste/wil num unico audio/sfx.raw (variavel SFX_MAPS).
DATA_ENTRIES ?= fstyle.sty audio/vocals e.gxt s.gxt p.gxt $(MAP_ENTRIES) $(BONUS_ENTRIES) nyc.gci test1.seq attract keyboard $(FRONTEND_DIR) \
                audio/bil.raw audio/bil.sdt audio/fstyle.raw audio/fstyle.sdt $(RADIO_ENTRIES)

ENGINE := $(shell tr -d '\r' < port/game_srcs.txt)
ENGINE += registry crt_stubs port_static_init
PLAT   := win32_n64 dinput_n64 crt_n64 miles_n64 bink_n64 gbh_n64 vid_n64 frame_n64 exports_n64 net_n64 n64_extra game_entry ramfs_n64

ENGINE_OBJS := $(addprefix $(OBJ_DIR)/port/gta2_re/Source/,$(addsuffix .o,$(ENGINE)))
PLAT_OBJS   := $(addprefix $(OBJ_DIR)/port/n64/,$(addsuffix .o,$(PLAT)))
OBJS := $(ENGINE_OBJS) $(PLAT_OBJS) $(OBJ_DIR)/port/n64/main_n64.o $(OBJ_DIR)/port/n64/exc_fix.o $(OBJ_DIR)/port/n64/render_n64.o $(OBJ_DIR)/port/n64/audio_n64.o

CXX_STD ?= -std=gnu++17
CXX_ENGINE = $(CXX_STD) -fshort-wchar -fms-extensions -fpermissive -w -DGTA2_PORT=1 -DN64 -fno-exceptions -fno-rtti \
             -include port/compat/gcc_compat.h -include port/compat/port_prefix.h \
             -Iport/compat -Iport/compat_ci -Iport/n64 -Iport/gta2_re/Source -Iport/gta2_re -MMD -MP $(EXTRA_CFLAGS)

# Motor: otimiza por tamanho (a RAM do N64 e o gargalo; o codigo ocupa ~1,9 MB dos 8 MB).
# Arquivos mais pesados por quadro (mapa, sprites, colisao, fisica do carro, matematica): -O2 (mais rapido, codigo maior).
HOT_ENGINE := MapRenderer sprite SpriteRenderer SpriteGrid Draw map_0x370 collide CarPhysics Fix16_Point fix16 ang16
HOT_OBJS := $(addprefix $(OBJ_DIR)/port/gta2_re/Source/,$(addsuffix .o,$(HOT_ENGINE)))
ENGINE_OPT ?= -Os
$(filter-out $(HOT_OBJS),$(ENGINE_OBJS)): N64_CXXFLAGS += $(ENGINE_OPT)
# upstream gta2_re asserts on fixed-point overflow (Fix16 *, +, -); the shipped game just wraps, so they are compiled out
$(ENGINE_OBJS): N64_CXXFLAGS += -DNDEBUG
$(HOT_OBJS): N64_CXXFLAGS += -O2

# crt_stubs.cpp usa especificacoes de excecao dinamicas (invalidas em C++17); a camada n64 foi validada em C++14.
$(OBJ_DIR)/port/gta2_re/Source/crt_stubs.o $(PLAT_OBJS): CXX_STD = -std=gnu++14

$(OBJ_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo "    [CXX] $<"
	$(N64_CXX) $(N64_CXXFLAGS) $(CXX_ENGINE) -c $< -o $@

# Margem de seguranca de video (pontos do VI, base 640x480). 0 = imagem inteira (emulador); aumente se a TV/upscaler cortar as bordas.
OVERSCAN_X ?= 36
OVERSCAN_Y ?= 28
$(OBJ_DIR)/port/n64/main_n64.o: N64_CFLAGS += -DN64_OVERSCAN_X=$(OVERSCAN_X) -DN64_OVERSCAN_Y=$(OVERSCAN_Y) $(EXTRA_CFLAGS)
$(OBJ_DIR)/port/n64/render_n64.o: N64_CFLAGS += $(EXTRA_CFLAGS)

# Otimizacao da camada de plataforma (renderer/conversao/desenho): codigo pequeno e quente por quadro.
PORT_OPT ?= -O3
$(PLAT_OBJS): N64_CXXFLAGS += $(PORT_OPT)
$(OBJ_DIR)/port/n64/render_n64.o: N64_CFLAGS += $(PORT_OPT)

$(OBJ_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "    [CC]  $<"
	$(N64_CC) $(N64_CFLAGS) -std=gnu11 -MMD -MP -c $< -o $@

stage-data:
	@bash tools/stage_data.sh "$(GAME_DATA)" "$(FS_DIR)" $(DATA_ENTRIES)

# Regra explicita (vence a regra generica do n64.mk): raiz do DragonFS = $(FS_DIR), entao rom:/data/x.
$(BUILD_DIR)/gta2_recomp.dfs: stage-data
	@mkdir -p $(dir $@)
	@echo "    [DFS] $@"
	$(N64_MKDFS) $@ $(FS_DIR)

$(BUILD_DIR)/gta2_recomp.elf: N64_LDFLAGS += $(EXTRA_LDFLAGS)
$(BUILD_DIR)/gta2_recomp.elf: $(OBJS)

-include $(OBJS:.o=.d)

gta2_recomp.z64: N64_ROM_TITLE = "GTA2 RECOMP BOOT"
gta2_recomp.z64: $(BUILD_DIR)/gta2_recomp.dfs

all: gta2_recomp.z64

clean:
	rm -rf $(BUILD_DIR) gta2_recomp.z64 $(FS_DIR)

.PHONY: all clean stage-data
