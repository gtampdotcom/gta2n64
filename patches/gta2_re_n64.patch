+#pragma once
+// Populacao do tech demo N64: percentual da quantidade ORIGINAL de pedestres e carros (100 = igual ao PC).
+// Ajuste so este numero: 60 = 40% menos gente e carros. Pode passar -DN64_POP_PCT=50 no Makefile.
