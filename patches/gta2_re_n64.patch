+#define N64_TETO_PEDS_EMERGENCIA 14  // policiais/SWAT/FBI/medicos vivos (original 30; SWAT so nasce abaixo de este-4)
+#define N64_TETO_PARTICULAS      160 // particulas/sprites de fogo, fumaca, sangue vivos (por tick)
+#else
+#define N64_TETO_EQUIPES_POLICIA 20
+#define N64_TETO_PEDS_EMERGENCIA 30
+#define N64_TETO_PARTICULAS      100000
+#endif
+
