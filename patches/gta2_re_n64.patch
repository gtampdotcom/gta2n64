+#ifndef N64_PED_PCT
+#define N64_PED_PCT 20
+#endif
+#else
+#define N64_PED_PCT 100
+#endif
+
+// ---- TETOS DE TUMULTO (N64): limites para cenas caoticas (policia/SWAT, fogo) ----
+// PC (original): equipes de policia 20, peds de emergencia 30, particulas = so o limite do pool.
